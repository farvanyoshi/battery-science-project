// Access to the numbers in /data (see data/README.md).
// data/processed is generated by `make data`; data/original holds values from the submitted paper.
// Paths starting with "/" resolve from the project root, so this works from any file.

#let _load(path) = csv(path, row-type: dictionary)

#let figure-index = _load("/data/processed/figures.csv")
#let readouts = _load("/data/processed/readouts.csv")
#let fits = _load("/data/processed/fits.csv")
#let effective-capacity = _load("/data/processed/effective-capacity.csv")
#let internal-resistance = _load("/data/original/internal-resistance.csv")

/// The row of figures.csv for a figure label, e.g. `figure-info("C2-D1")`.
#let figure-info(label) = {
  let rows = figure-index.filter(r => r.figure == label)
  assert(rows.len() == 1, message: "no graph with the label " + label + " in data/processed/figures.csv")
  rows.first()
}

/// Format a number with a fixed number of decimals (keeps trailing zeros, uses a real minus sign).
#let fixed(x, digits) = {
  let s = if digits <= 0 { str(int(calc.round(x))) } else {
    let s = str(calc.round(x, digits: digits))
    if not s.contains(".") { s += "." }
    let (whole, frac) = s.split(".")
    whole + "." + frac + "0" * (digits - frac.len())
  }
  s.replace("-", "−")
}

/// Format a number to `n` significant figures, as the original graphs showed them (four by default).
/// Values below 10⁻⁴ are written in scientific notation.
#let sig(x, n: 4) = {
  let x = float(x)
  if x == 0 { return "0" }
  let mag = int(calc.floor(calc.log(calc.abs(x), base: 10)))
  // Rounding can carry into the next power of ten (9.9996 -> 10.00).
  if calc.abs(calc.round(x, digits: calc.max(n - 1 - mag, 0))) >= calc.pow(10.0, mag + 1) { mag += 1 }
  if mag < -4 {
    let m = x / calc.pow(10.0, mag)
    return $#fixed(m, n - 1) times 10^(#mag)$
  }
  fixed(x, calc.max(n - 1 - mag, 0))
}
